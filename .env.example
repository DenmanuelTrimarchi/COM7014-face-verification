# Copy this file to .env and fill in paths inside your own access-controlled
# research storage. Benchmark images, protocol files, model binaries, derived
# embeddings and any review database must live there, never inside this
# repository. .env is git-ignored and its values are never printed by the
# programme or written into a published result.
#
# Values containing spaces may be quoted with single or double quotes.

# Root containing the extracted dataset image directories (e.g. lfw_funneled/).
FACE_DATA_ROOT=/path/to/research-storage/face-verification/datasets

# Root containing the official pair-protocol files: pairsDevTrain.txt,
# pairsDevTest.txt, pairs.txt and pairs_CPLFW.txt.
FACE_PROTOCOL_ROOT=/path/to/research-storage/face-verification/protocols

# Root of the flat, authors'-distributed raw CPLFW image set (extracted from
# images.rar). Deliberately separate from FACE_DATA_ROOT/cplfw, which would
# hold the non-interchangeable pre-aligned cp-aligned.zip copy instead.
FACE_CPLFW_RAW_ROOT=/path/to/research-storage/face-verification/datasets/cplfw_raw

# Root containing the two pinned OpenCV Zoo model files (.onnx).
FACE_MODEL_ROOT=/path/to/research-storage/face-verification/models

# Secret key for the opaque public identifiers. REQUIRED.
#
# Public identifiers are HMAC-SHA-256 over the identity or sample name keyed by
# this value. Without a secret key, a published identifier can be reversed by
# hashing a list of candidate dataset names, which for a public benchmark is a
# short list. The key is held in memory only: it is never printed, never stored
# in a result, and no digest or fingerprint of it appears in any artefact.
#
# Accepts URL-safe base64 or hexadecimal and requires at least 32 decoded bytes.
# Generate one with:
#
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
#
# Changing the key changes every identifier, so results and any existing local
# review database produced under the old key are no longer comparable. Delete
# the review database and re-run if you rotate it. Do not paste a real key here
# — this file is committed; put it in .env, which is git-ignored.
FACE_ID_HMAC_KEY=

# Optional: Balanced Faces in the Wild, for the supplementary open-set
# experiment (Experiment 6). Obtain it from the official project under its own
# terms; nothing here downloads it and no mirror is used. Point this at the
# extracted tree whose layout is <subgroup>/<identity>/<image>.jpg.
# FACE_BFW_ROOT=/path/to/research-storage/bfw/uncropped-face-samples
#
# Where the official bfw*datatable*.csv lives. Defaults to FACE_BFW_ROOT.
# FACE_BFW_METADATA_ROOT=/path/to/research-storage/bfw

# Optional: InsightFace SCRFD + ArcFace buffalo_l, for the pipeline comparison.
# The official pretrained-model terms permit non-commercial research. This
# project is a non-commercial MSc academic artefact. The model files are not
# redistributed, committed or downloaded automatically. Setting this alone is
# not enough: the SHA-256 digests of the approved weight files must also be
# pinned in source, because a reportable evaluation never accepts digests as
# arguments.
# FACE_ARCFACE_MODEL_ROOT=/path/to/research-storage/insightface/buffalo_l

# Optional embedding cache. Leave unset unless you understand that the cache
# would contain biometric templates and can restrict its permissions.
# FACE_CACHE_ROOT=/path/to/research-storage/face-verification/cache
